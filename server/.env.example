# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=5000

# MongoDB Atlas connection string
# Get this from: Atlas → Cluster → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/attendance_db?retryWrites=true&w=majority&appName=AttendanceMS

# JWT — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Admin account seeded on first startup
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@123

# QR signing secret
QR_SECRET=change_this_qr_secret

# Comma-separated allowed CORS origins (leave blank to allow localhost:5173 only)
ALLOWED_ORIGINS=
